{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "app",
	"main": "src/worker.mjs",
	"compatibility_date": "2026-10-26",
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"vars": {
		"ACCOUNT_ORIGIN": "https://app.reservas-alceu.workers.dev"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edulab-dev",
			"database_id": "f68cd7a7-4f21-4dfb-9b90-a6356e34e150",
			"migrations_dir": "migrations",
			"remote": false
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/index.html",
			"/api",
			"/api/*",
			"/pages/conta.html",
			"/pages/verificar-email.html"
		],
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"build": {
		"command": "npm run build"
	},
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787
	}
}
