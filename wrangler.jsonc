{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "app",
	"main": "src/worker.mjs",
	"compatibility_date": "2026-10-26",
	// Banco de desenvolvimento criado na Cloudflare; dev continua usando a cópia local.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edulab-dev",
			"database_id": "f68cd7a7-4f21-4dfb-9b90-a6356e34e150",
			"migrations_dir": "migrations",
			"remote": false
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/api",
			"/api/*"
		],
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"build": {
		"command": "npm run build"
	},
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787
	}
}
